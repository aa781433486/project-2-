<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:orientation="vertical"
android:background="@color/colorBackground">

<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="horizontal"
android:gravity="center_vertical"
android:padding="12dp"
android:background="@drawable/stat_card_bg_blue">

<EditText
android:id="@+id/etSearchProducts"
android:layout_width="0dp"
android:layout_height="44dp"
android:layout_weight="1"
android:hint="🔍 ابحث عن منتج..."
android:padding="10dp"
android:background="@drawable/edit_text_background"
android:gravity="right|center_vertical"
android:textColorHint="#BDBDBD"
android:textColor="@color/colorTextPrimary"
android:layout_marginEnd="8dp"/>

<Button
android:id="@+id/btnSearchType"
android:layout_width="72dp"
android:layout_height="44dp"
android:text="اسم"
android:textSize="12sp"
android:background="@drawable/btn_orange_rounded"
android:textColor="#FFFFFF"/>

</LinearLayout>


<!-- تم تعديل هذا الجزء فقط -->
<HorizontalScrollView
android:layout_width="match_parent"
android:layout_height="0dp"
android:layout_weight="1"
android:fillViewport="true">

<ScrollView
android:layout_width="wrap_content"
android:layout_height="match_parent"
android:padding="8dp">

<TableLayout
android:id="@+id/tableProducts"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:stretchColumns="6">

<TableRow
android:background="@drawable/stat_card_bg_blue"
android:padding="4dp">


<TextView
android:text="الربح"
android:textStyle="bold"
android:textColor="#FFFFFF"
android:gravity="center"
android:padding="8dp"
android:textSize="13sp"/>


<TextView
android:text="سعر البيع"
android:textStyle="bold"
android:textColor="#FFFFFF"
android:gravity="center"
android:padding="8dp"
android:textSize="13sp"/>


<TextView
android:text="سعر الشراء"
android:textStyle="bold"
android:textColor="#FFFFFF"
android:gravity="center"
android:padding="8dp"
android:textSize="13sp"/>


<TextView
android:text="الكراتين"
android:textStyle="bold"
android:textColor="#FFFFFF"
android:gravity="center"
android:padding="8dp"
android:textSize="13sp"/>


<TextView
android:text="الوحدات"
android:textStyle="bold"
android:textColor="#FFFFFF"
android:gravity="center"
android:padding="8dp"
android:textSize="13sp"/>


<TextView
android:text="النوع"
android:textStyle="bold"
android:textColor="#FFFFFF"
android:gravity="center"
android:padding="8dp"
android:textSize="13sp"/>


<TextView
android:text="المنتج"
android:textStyle="bold"
android:textColor="#FFFFFF"
android:gravity="center"
android:padding="8dp"
android:textSize="13sp"/>


<TextView
android:text="الرقم"
android:textStyle="bold"
android:textColor="#FFFFFF"
android:gravity="center"
android:padding="8dp"
android:textSize="13sp"/>


</TableRow>

</TableLayout>

</ScrollView>

</HorizontalScrollView>



<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="vertical"
android:background="@drawable/card_background"
android:padding="12dp"
android:elevation="4dp">

<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="horizontal"
android:layout_marginBottom="8dp">

<Button
android:id="@+id/btnExportProducts"
android:layout_width="0dp"
android:layout_height="48dp"
android:layout_weight="1"
android:layout_marginEnd="8dp"
android:text="📤 تصدير"
android:textStyle="bold"
android:textColor="#FFFFFF"
android:background="@drawable/btn_blue_rounded"/>

<Button
android:id="@+id/btnImportProducts"
android:layout_width="0dp"
android:layout_height="48dp"
android:layout_weight="1"
android:text="📥 استيراد"
android:textStyle="bold"
android:textColor="#FFFFFF"
android:background="@drawable/btn_orange_rounded"/>

</LinearLayout>


<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="horizontal">

<Button
android:id="@+id/btnEditDeleteProduct"
android:layout_width="0dp"
android:layout_height="48dp"
android:layout_weight="1"
android:background="@drawable/btn_orange_rounded"
android:text="✏️ تعديل / حذف"
android:textColor="#FFFFFF"
android:textStyle="bold"
android:textSize="14sp"
android:layout_marginEnd="8dp"/>


<Button
android:id="@+id/btnAddProduct"
android:layout_width="0dp"
android:layout_height="48dp"
android:layout_weight="1"
android:background="@drawable/btn_green_rounded"
android:text="➕ إضافة منتج"
android:textColor="#FFFFFF"
android:textStyle="bold"
android:textSize="14sp"/>

</LinearLayout>

</LinearLayout>

</LinearLayout>
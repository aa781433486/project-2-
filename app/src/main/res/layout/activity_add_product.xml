<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📦 إضافة / تحديث منتج"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/colorWhite"
            android:gravity="center"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/stat_card_bg_blue"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:elevation="4dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍 اسم المنتج"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:layout_marginBottom="6dp"/>

            <AutoCompleteTextView
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="ابدأ بالكتابة للبحث أو إضافة جديد..."
                android:completionThreshold="1"
                android:padding="12dp"
                android:background="@drawable/edit_text_background"
                android:inputType="text"
                android:gravity="right|center_vertical"
                android:textColorHint="#BDBDBD"
                android:textSize="15sp"
                android:layout_marginBottom="10dp"/>
				
			<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="نوع البيع"
			android:textStyle="bold"
			android:layout_marginTop="12dp"/>
			
			<RadioGroup
			android:id="@+id/rgSaleType"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal">
			
			<RadioButton
			android:id="@+id/rbRetail"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="تجزئة"/>
			
			<RadioButton
			android:id="@+id/rbWholesale"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="جملة"/>
			</RadioGroup>

            <LinearLayout
                android:id="@+id/cardStockInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFF8E1"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvStockStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📦 مخزون حالي: 0"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorSuccess"/>

                <TextView
                    android:id="@+id/tvActionHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="12sp"
                    android:textColor="@color/colorWarning"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

        </LinearLayout>
		
		<!-- ===================== التجزئة ===================== -->
		
		<LinearLayout
		android:id="@+id/layoutRetail"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:background="@drawable/card_background"
		android:padding="16dp"
		android:layout_marginBottom="12dp"
		android:visibility="gone">
		
		<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="🛒 بيانات التجزئة"
		android:textStyle="bold"
		android:textSize="16sp"/>
		
		<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="سعر شراء الوحدة"
		android:textSize="12sp"
		android:textColor="@color/colorTextSecondary"
		android:layout_marginTop="8dp"
		android:layout_marginBottom="4dp"/>

		<EditText
		android:id="@+id/etCostPriceRetail"
		android:layout_width="match_parent"
		android:layout_height="52dp"
		android:hint="سعر شراء الوحدة"
		android:inputType="numberDecimal"
		android:padding="12dp"
		android:background="@drawable/edit_text_background"/>

		<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="سعر بيع الوحدة"
		android:textSize="12sp"
		android:textColor="@color/colorTextSecondary"
		android:layout_marginTop="8dp"
		android:layout_marginBottom="4dp"/>

		<EditText
		android:id="@+id/etRetailPrice"
		android:layout_width="match_parent"
		android:layout_height="52dp"
		android:hint="سعر بيع الوحدة"
		android:inputType="numberDecimal"
		android:padding="12dp"
		android:background="@drawable/edit_text_background"/>

		<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="عدد الوحدات"
		android:textSize="12sp"
		android:textColor="@color/colorTextSecondary"
		android:layout_marginTop="8dp"
		android:layout_marginBottom="4dp"/>

		<EditText
		android:id="@+id/etRetailQuantity"
		android:layout_width="match_parent"
		android:layout_height="52dp"
		android:hint="عدد الوحدات"
		android:inputType="number"
		android:padding="12dp"
		android:background="@drawable/edit_text_background"/>
		</LinearLayout>
		
		<!-- ===================== الجملة ===================== -->
		
		<LinearLayout
		android:id="@+id/layoutWholesale"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:background="@drawable/card_background"
		android:padding="16dp"
		android:layout_marginBottom="12dp"
		android:visibility="gone">
		
		<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="📦 بيانات الجملة"
		android:textStyle="bold"
		android:textSize="16sp"/>
		
		<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="سعر شراء الكرتون"
		android:textSize="12sp"
		android:textColor="@color/colorTextSecondary"
		android:layout_marginTop="8dp"
		android:layout_marginBottom="4dp"/>

		<EditText
		android:id="@+id/etCostPriceWholesale"
		android:layout_width="match_parent"
		android:layout_height="52dp"
		android:hint="سعر شراء الكرتون"
		android:inputType="numberDecimal"
		android:padding="12dp"
		android:background="@drawable/edit_text_background"/>

		<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="سعر بيع الكرتون"
		android:textSize="12sp"
		android:textColor="@color/colorTextSecondary"
		android:layout_marginTop="8dp"
		android:layout_marginBottom="4dp"/>

		<EditText
		android:id="@+id/etWholesalePrice"
		android:layout_width="match_parent"
		android:layout_height="52dp"
		android:hint="سعر بيع الكرتون"
		android:inputType="numberDecimal"
		android:padding="12dp"
		android:background="@drawable/edit_text_background"/>

		<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="عدد الكراتين"
		android:textSize="12sp"
		android:textColor="@color/colorTextSecondary"
		android:layout_marginTop="8dp"
		android:layout_marginBottom="4dp"/>

		<EditText
		android:id="@+id/etWholesaleQuantity"
		android:layout_width="match_parent"
		android:layout_height="52dp"
		android:hint="عدد الكراتين"
		android:inputType="number"
		android:padding="12dp"
		android:background="@drawable/edit_text_background"/>

		<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="عدد الوحدات داخل الكرتون"
		android:textSize="12sp"
		android:textColor="@color/colorTextSecondary"
		android:layout_marginTop="8dp"
		android:layout_marginBottom="4dp"/>

		<EditText
		android:id="@+id/etUnitsPerBox"
		android:layout_width="match_parent"
		android:layout_height="52dp"
		android:hint="عدد الوحدات داخل الكرتون"
		android:inputType="number"
		android:padding="12dp"
		android:background="@drawable/edit_text_background"/>
		</LinearLayout>

        
        <Button
            android:id="@+id/btnAdd"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="➕ إضافة منتج جديد"
            android:background="@drawable/btn_green_rounded"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:elevation="4dp"/>

    </LinearLayout>
</ScrollView>

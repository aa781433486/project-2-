<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="القائمة"
                android:src="@android:drawable/ic_menu_more"
                android:tint="@color/colorTextPrimary"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

        </LinearLayout>

        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌟 نظام البقالة"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/colorWhite"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:scrollHorizontally="true"
            android:gravity="center"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/stat_card_bg_blue"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📊 إحصائيات اليوم"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary"
            android:layout_marginBottom="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/stat_card_bg_blue"
                android:padding="12dp"
                android:gravity="center"
                android:layout_marginEnd="6dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💰 مبيعات اليوم"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"/>
                <TextView
                    android:id="@+id/tvStatSales"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 ر.س"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/stat_card_bg_green"
                android:padding="12dp"
                android:gravity="center"
                android:layout_marginStart="6dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📋 فواتير اليوم"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"/>
                <TextView
                    android:id="@+id/tvStatInvoices"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/stat_card_bg_red"
                android:padding="12dp"
                android:gravity="center"
                android:layout_marginEnd="6dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💳 إجمالي الديون"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"/>
                <TextView
                    android:id="@+id/tvStatDebts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 ر.س"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/stat_card_bg_orange"
                android:padding="12dp"
                android:gravity="center"
                android:layout_marginStart="6dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️ مخزون منخفض"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"/>
                <TextView
                    android:id="@+id/tvStatLowStock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
            </LinearLayout>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🗂 القوائم الرئيسية"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary"
            android:layout_marginBottom="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnProducts"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="📦 المنتجات"
                android:background="@drawable/btn_owner"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_marginEnd="6dp"/>

            <Button
                android:id="@+id/btnPurchase"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="🛒 المبيعات"
                android:background="@drawable/btn_purchase"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_marginStart="6dp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnDebts"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="💳 الديون"
                android:background="@drawable/btn_red_rounded"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_marginEnd="6dp"/>

            <Button
                android:id="@+id/btnInvoices"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="📋 الفواتير"
                android:background="@drawable/btn_green_rounded"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_marginStart="6dp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/btnReports"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="📊 التقارير"
                android:background="@drawable/btn_blue_rounded"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_marginEnd="6dp"/>

            <Button
                android:id="@+id/btnProfit"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="💹 الربح"
                android:background="@drawable/btn_orange_rounded"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_marginStart="6dp"/>

        </LinearLayout>

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="🚪 تسجيل الخروج"
            android:background="@drawable/btn_logout"
            android:textColor="#FFFFFF"
            android:textSize="15sp"/>

    </LinearLayout>
</ScrollView>

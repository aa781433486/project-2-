<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💹 تقرير الأرباح"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/colorWhite"
            android:gravity="center"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/stat_card_bg_green"/>

        <!-- اليوم -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:elevation="4dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvDayTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📅 اليوم"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvDayProfit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0.00 ر.س"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/colorSuccess"
                android:layout_marginBottom="8dp"/>

            <com.mycompany.app.MiniChartView
                android:id="@+id/chartDay"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/tvDayList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/colorTextSecondary"
                android:lineSpacingExtra="4dp"/>

        </LinearLayout>

        <!-- الأسبوع -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:elevation="4dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvWeekTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🗓️ هذا الأسبوع"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvWeekProfit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0.00 ر.س"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/colorSuccess"
                android:layout_marginBottom="8dp"/>

            <com.mycompany.app.MiniChartView
                android:id="@+id/chartWeek"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/tvWeekList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/colorTextSecondary"
                android:lineSpacingExtra="4dp"/>

        </LinearLayout>

        <!-- الشهر -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:elevation="4dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvMonthTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📆 هذا الشهر"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvMonthProfit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0.00 ر.س"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/colorSuccess"
                android:layout_marginBottom="8dp"/>

            <com.mycompany.app.MiniChartView
                android:id="@+id/chartMonth"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/tvMonthList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/colorTextSecondary"
                android:lineSpacingExtra="4dp"/>

        </LinearLayout>

        <!-- السنة -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:elevation="4dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvYearTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📈 هذه السنة"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvYearProfit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0.00 ر.س"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/colorSuccess"
                android:layout_marginBottom="8dp"/>

            <com.mycompany.app.MiniChartView
                android:id="@+id/chartYear"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/tvYearList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/colorTextSecondary"
                android:lineSpacingExtra="4dp"/>

        </LinearLayout>

    </LinearLayout>
</ScrollView>

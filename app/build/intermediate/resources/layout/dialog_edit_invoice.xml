<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- اسم العميل -->
        <EditText
            android:id="@+id/etCustomer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="اسم العميل"
            android:enabled="false"
            android:inputType="textPersonName"
            android:padding="8dp" />

        <!-- التاريخ -->
        <EditText
            android:id="@+id/etDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="التاريخ"
            android:inputType="text"
            android:padding="8dp"
            android:layout_marginTop="6dp" />

        <!-- زر لإضافة صنف جديد -->
        <Button
            android:id="@+id/btnAddItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="إضافة صنف"
            android:layout_marginTop="8dp" />

        <!-- الحاوية لكل صف صنف -->
        <LinearLayout
            android:id="@+id/itemRowsViews"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp" />

        <!-- المجموع النهائي -->
        <TextView
            android:id="@+id/tvEditTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="المجموع: 0.00"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textStyle="bold" />

        <!-- الحقل الوحيد للتفاصيل القديم إذا أحببت عرضه -->
        <EditText
            android:id="@+id/etDetails"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
